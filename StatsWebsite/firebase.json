{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "database.rules.json", ".firebaserc", "**/.*"],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ]
  }
}
